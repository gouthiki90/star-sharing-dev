generator client {
  provider     = "prisma-client"
  output       = "./client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model location {
  id          String   @id @db.VarChar
  latitude    Float
  longitude   Float
  local_time  DateTime @db.Timestamptz(6)
  create_date DateTime @default(now()) @db.Timestamptz(6)
  update_date DateTime @db.Timestamptz(6)
}
